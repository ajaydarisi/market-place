# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key (server-only): used for admin provisioning (scripts/set-admin.mjs)
# and looking up notification-email recipients. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional email (Resend). Leave RESEND_API_KEY unset to keep email off;
# in-app notifications still work. Verify a sending domain for EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=SkillPilot <notifications@yourdomain.com>
NEXT_PUBLIC_APP_URL=https://your-app-url.com

# Cloudflare Turnstile (captcha on /auth)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# AI provider (OpenAI-compatible chat-completions API; server-side only)
AI_API_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=your-ai-api-key
AI_MODEL=deepseek-v4-pro
